<resources>
    <style name="Theme.QRCodeSimple.Base" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_secondary_container</item>
        <item name="colorTertiary">@color/app_primary</item>
        <item name="colorOnTertiary">@color/app_on_primary</item>
        <item name="colorTertiaryContainer">@color/app_primary_container</item>
        <item name="colorOnTertiaryContainer">@color/app_on_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceBright">@color/app_surface_variant</item>
        <item name="colorSurfaceDim">@color/app_background</item>
        <item name="colorSurfaceContainerLowest">@color/app_background</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_variant</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorSurfaceInverse">@color/app_text_primary</item>
        <item name="colorOnSurfaceInverse">@color/app_background</item>
        <item name="colorPrimaryInverse">@color/app_primary_container</item>
        <item name="colorOnBackground">@color/app_text_primary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_variant</item>
        <item name="colorError">@color/app_error</item>
        <item name="colorOnError">@color/app_on_error</item>
        <item name="colorErrorContainer">@color/app_error_container</item>
        <item name="colorOnErrorContainer">@color/app_on_error_container</item>
        <item name="colorControlNormal">@color/app_text_secondary</item>
        <item name="colorControlActivated">@color/app_primary</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/app_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/app_light_system_bars</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.QRCodeSimple.MaterialAlertDialog</item>
        <item name="materialButtonStyle">@style/Widget.QRCodeSimple.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.QRCodeSimple.Panel</item>
        <item name="bottomNavigationStyle">@style/Widget.QRCodeSimple.BottomNavigationView</item>
    </style>

    <style name="Theme.QRCodeSimple" parent="Theme.QRCodeSimple.Base">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.QRCodeSimple.ActionBar" parent="Theme.QRCodeSimple.Base">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <item name="actionBarStyle">@style/Widget.QRCodeSimple.ActionBar</item>
    </style>

    <style name="Theme.QRCodeSimple.Dialog" parent="Theme.QRCodeSimple">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.QRCodeSimple.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_variant</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.QRCodeSimple.Panel</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.QRCodeSimple.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.QRCodeSimple.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.QRCodeSimple.Button.Text</item>
    </style>

    <style name="Widget.QRCodeSimple.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/app_surface</item>
        <item name="titleTextStyle">@style/TextAppearance.QRCodeSimple.ToolbarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.QRCodeSimple.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
