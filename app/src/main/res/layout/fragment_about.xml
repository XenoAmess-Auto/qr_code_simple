<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- App Icon -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Version -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="12dp" />

        <!-- Language Selector -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/language"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Privacy Settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/privacy_settings"
            app:icon="@drawable/ic_security"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Check for updates + auto-check switch in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/check_update"
                app:icon="@drawable/ic_system_update"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_check_update"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAutoUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Beta is always a deliberate manual check. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckBetaUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/check_beta_update"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVersionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/version_history"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Buy me a coffee button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/buy_me_a_coffee"
            app:icon="@drawable/ic_coffee" />

        <!-- Project - Single line button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGitHubProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sources"
            app:icon="@drawable/ic_github"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Maintainer - Single line button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGitHubMaintainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/maintainer"
            app:icon="@drawable/ic_github"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- License -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/license"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</ScrollView>
