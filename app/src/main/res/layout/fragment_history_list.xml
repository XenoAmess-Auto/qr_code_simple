<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- 统计卡片：默认收起为单行摘要，点击展开明细（MaterialCardView 自动适配亮暗表面色） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statsCard"
        style="@style/Widget.QRCodeSimple.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStatsSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.RowTitle"
                    android:textColor="@color/app_text_primary" />

                <ImageView
                    android:id="@+id/ivStatsToggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    android:importantForAccessibility="no"
                    app:tint="@color/app_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/statsDetailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvStats7d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.Metadata"
                    android:textColor="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/tvStats30d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.Metadata"
                    android:textColor="@color/app_text_secondary" />

                <com.xenoamess.qrcodesimple.SimpleBarChartView
                    android:id="@+id/statsBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 搜索栏 -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.QRCodeSimple.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:queryHint="@string/search_history_hint" />

    </com.google.android.material.card.MaterialCardView>

    <!-- 过滤器 Tab -->
    <GridLayout
        android:id="@+id/filterTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:columnCount="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterAll"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:singleLine="true"
            android:text="@string/all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterScanned"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:singleLine="true"
            android:text="@string/scanned" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterGenerated"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:singleLine="true"
            android:text="@string/generated" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterFavorite"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:minHeight="48dp"
            android:singleLine="true"
            android:text="@string/chip_favorites" />

    </GridLayout>

    <!-- 排序 + 高级筛选 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSort"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdvancedFilter"
            style="@style/Widget.QRCodeSimple.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/advanced_filter" />

    </LinearLayout>

    <!-- 标签筛选 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- 历史记录列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 空视图 -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_history"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/app_text_secondary"
        android:visibility="gone" />

    <!-- 清除全部按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearAll"
        style="@style/Widget.QRCodeSimple.Button.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/clear_all"
        app:icon="@drawable/ic_delete" />

</LinearLayout>
