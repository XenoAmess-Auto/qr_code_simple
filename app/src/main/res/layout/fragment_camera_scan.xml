<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_panel">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 扫描线动画（纯装饰，不参与无障碍树与触摸） -->
    <com.xenoamess.qrcodesimple.ScannerOverlayView
        android:id="@+id/scannerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 框选识别区域（默认隐藏，开启框选模式后显示）。
         位于顶栏/缩放条之下，保证按钮可点击。 -->
    <com.xenoamess.qrcodesimple.ScanRegionView
        android:id="@+id/scanRegionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top Bar with hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/camera_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/point_camera_at_qr_code"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnScanRegion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_crop"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/scan_region"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_gallery"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/from_gallery"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnContinuousScan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_continuous_scan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/continuous_scan"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_flash_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/flash"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_switch_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/switch_camera"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Zoom Slider (Left side, more space) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="80dp"
        android:paddingBottom="80dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/camera_panel"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/app_outline"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:padding="8dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/zoomSlider"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="270"
                    android:valueFrom="1"
                    android:valueTo="10"
                    android:stepSize="0.1"
                    android:value="1"
                    app:trackHeight="6dp"
                    app:thumbRadius="8dp"
                    app:thumbColor="@android:color/white"
                    app:trackColorActive="@color/app_primary"
                    app:trackColorInactive="@color/app_outline"
                    app:haloColor="@color/app_primary"
                    app:haloRadius="16dp" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Zoom Value Indicator -->
    <TextView
        android:id="@+id/tvZoomValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="60dp"
        android:layout_marginTop="80dp"
        tools:text="1.0x"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@color/camera_panel"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <!-- Result Card (Bottom) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        style="@style/Widget.QRCodeSimple.Panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/scan_result"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/app_text_primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnFavoriteResult"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_star_border"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_to_favorites"
                    app:tint="@color/app_text_secondary" />

                <ImageButton
                    android:id="@+id/btnNoteResult"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_note"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_notes"
                    app:tint="@color/app_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextResult"
                    style="@style/Widget.QRCodeSimple.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:visibility="gone"
                    tools:text="1/2" />

                <ImageButton
                    android:id="@+id/btnCloseResult"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    app:tint="@color/app_text_secondary" />

            </LinearLayout>

            <!-- Content Type Label -->
            <TextView
                android:id="@+id/tvContentType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_app_metadata_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/chip_content_wifi"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/app_on_primary_container"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scanning"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/app_text_primary"
                android:textIsSelectable="true"
                android:accessibilityLiveRegion="polite" />

            <!-- Smart Action Button (WiFi Connect, etc.) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSmartAction"
                style="@style/Widget.QRCodeSimple.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:icon="@drawable/ic_wifi" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyResult"
                    style="@style/Widget.QRCodeSimple.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareResult"
                    style="@style/Widget.QRCodeSimple.Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/share"
                    app:icon="@drawable/ic_share" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
