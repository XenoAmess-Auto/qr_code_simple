<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/backup_restore"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/app_text_primary" />

        <!-- 导出选项 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QRCodeSimple.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_label"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.SectionLabel"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportJson"
                    style="@style/Widget.QRCodeSimple.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/export_json" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCsv"
                    style="@style/Widget.QRCodeSimple.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/export_csv" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportExcel"
                    style="@style/Widget.QRCodeSimple.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/export_excel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportEncrypted"
                    style="@style/Widget.QRCodeSimple.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_encrypted" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 导入选项 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QRCodeSimple.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/import_data"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.SectionLabel"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImport"
                    style="@style/Widget.QRCodeSimple.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_data" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- WebDAV 同步 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QRCodeSimple.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/webdav_sync"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.SectionLabel"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.QRCodeSimple.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/webdav_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWebdavUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.QRCodeSimple.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/webdav_username">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWebdavUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.QRCodeSimple.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/webdav_password">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWebdavPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text|textPassword" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/webdav_encrypted_hint"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.Metadata" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/webdav_auto_upload"
                        android:textAppearance="@style/TextAppearance.QRCodeSimple.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWebdavAutoUpload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        app:thumbTint="@color/app_switch_thumb"
                        app:trackTint="@color/app_switch_track" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvWebdavLastSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.Metadata" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWebdavUpload"
                        style="@style/Widget.QRCodeSimple.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_4"
                        android:text="@string/webdav_upload" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWebdavDownload"
                        style="@style/Widget.QRCodeSimple.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="@string/webdav_download" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
