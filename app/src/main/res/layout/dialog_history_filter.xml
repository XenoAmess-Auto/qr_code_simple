<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_order"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSortNewest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_sort_newest" />

            <RadioButton
                android:id="@+id/rbSortOldest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/chip_sort_oldest" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/filter_time_range"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbTimeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_time_all" />

            <RadioButton
                android:id="@+id/rbTimeToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_time_today" />

            <RadioButton
                android:id="@+id/rbTime7d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_time_7d" />

            <RadioButton
                android:id="@+id/rbTime30d"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_time_30d" />

        </RadioGroup>

        <Button
            android:id="@+id/btnPickType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/colorPrimary"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnPickFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</ScrollView>
