<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Editorial identity block: deliberately unboxed to keep the page light. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="18dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:cardBackgroundColor="@color/about_accent_soft"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/about_panel_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/about_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_about_version_badge"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/about_accent"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/license"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/about_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:background="@color/about_accent" />

        <TextView
            style="@style/Widget.QRCodeSimple.About.SectionLabel"
            android:layout_marginStart="10dp"
            android:text="@string/about_section_preferences" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.QRCodeSimple.About.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnLanguage"
                style="@style/Widget.QRCodeSimple.About.Row">

                <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_language"
                        app:tint="@color/about_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.QRCodeSimple.About.RowTitle"
                        android:text="@string/language" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        style="@style/Widget.QRCodeSimple.About.RowValue" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/about_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/about_divider" />

            <LinearLayout
                android:id="@+id/btnTheme"
                style="@style/Widget.QRCodeSimple.About.Row">

                <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_palette"
                        app:tint="@color/about_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.QRCodeSimple.About.RowTitle"
                        android:text="@string/theme_setting" />

                    <TextView
                        android:id="@+id/tvThemeValue"
                        style="@style/Widget.QRCodeSimple.About.RowValue" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/about_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/about_divider" />

            <LinearLayout
                android:id="@+id/btnPrivacy"
                style="@style/Widget.QRCodeSimple.About.Row">

                <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_security"
                        app:tint="@color/about_accent" />
                </FrameLayout>

                <TextView
                    style="@style/Widget.QRCodeSimple.About.RowTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/privacy_settings" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/about_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/updateSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@color/about_accent" />

            <TextView
                style="@style/Widget.QRCodeSimple.About.SectionLabel"
                android:layout_marginStart="10dp"
                android:text="@string/about_section_updates" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QRCodeSimple.About.SectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="52dp"
                        android:text="@string/check_update"
                        android:textColor="@color/about_on_accent"
                        app:backgroundTint="@color/about_accent"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_system_update"
                        app:iconTint="@color/about_on_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckBetaUpdate"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="48dp"
                        android:text="@string/check_beta_update"
                        android:textColor="@color/about_accent"
                        app:backgroundTint="@color/about_panel"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/about_accent"
                        app:strokeColor="@color/about_accent"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/about_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        style="@style/Widget.QRCodeSimple.About.RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/auto_check_update" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/about_switch_thumb"
                        app:trackTint="@color/about_switch_track" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/about_divider" />

                <LinearLayout
                    android:id="@+id/btnVersionHistory"
                    style="@style/Widget.QRCodeSimple.About.Row">

                    <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history"
                            app:tint="@color/about_accent" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.QRCodeSimple.About.RowTitle"
                        android:layout_width="0dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/version_history" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/about_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/about_divider" />

                <LinearLayout
                    android:id="@+id/btnCrashLogs"
                    style="@style/Widget.QRCodeSimple.About.Row">

                    <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bug_report"
                            app:tint="@color/about_accent" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.QRCodeSimple.About.RowTitle"
                        android:layout_width="0dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/crash_logs" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/about_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:background="@color/about_accent" />

        <TextView
            style="@style/Widget.QRCodeSimple.About.SectionLabel"
            android:layout_marginStart="10dp"
            android:text="@string/about_section_project" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.QRCodeSimple.About.SectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="52dp"
                android:text="@string/buy_me_a_coffee"
                android:textColor="@color/about_accent"
                app:backgroundTint="@color/about_accent_soft"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_coffee"
                app:iconTint="@color/about_accent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/about_divider" />

            <LinearLayout
                android:id="@+id/btnGitHubProject"
                style="@style/Widget.QRCodeSimple.About.Row">

                <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_github"
                        app:tint="@color/about_accent" />
                </FrameLayout>

                <TextView
                    style="@style/Widget.QRCodeSimple.About.RowTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sources" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/about_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/about_divider" />

            <LinearLayout
                android:id="@+id/btnGitHubMaintainer"
                style="@style/Widget.QRCodeSimple.About.Row">

                <FrameLayout style="@style/Widget.QRCodeSimple.About.IconTile">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_github"
                        app:tint="@color/about_accent" />
                </FrameLayout>

                <TextView
                    style="@style/Widget.QRCodeSimple.About.RowTitle"
                    android:layout_width="0dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/maintainer" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/about_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
