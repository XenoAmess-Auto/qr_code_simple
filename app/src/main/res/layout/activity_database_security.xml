<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 加密状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.QRCodeSimple.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/database_security"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.SectionLabel"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvEncryptionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.RowTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sqlcipher_description"
                    android:textAppearance="@style/TextAppearance.QRCodeSimple.Metadata" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 重置数据库按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDatabase"
            style="@style/Widget.QRCodeSimple.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/reset_database" />

        <!-- 导出备份按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportBackup"
            style="@style/Widget.QRCodeSimple.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_restore" />

    </LinearLayout>

</ScrollView>
